# RIMRIFT: a copy of the database (deploy/afterhours16.sh backup; run by afterhours16-backup.timer)
[Unit]
Description=RIMRIFT online server: back up the database

[Service]
Type=oneshot
ExecStart=/usr/local/bin/afterhours16 backup
# (behind the games for the CPU and the disk)
Nice=10
IOSchedulingClass=idle
