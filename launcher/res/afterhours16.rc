#define RT_MANIFEST 24
1 ICON "afterhours16.ico"
1 RT_MANIFEST "afterhours16.exe.manifest"
1 VERSIONINFO
FILEVERSION 0,4,4,0
PRODUCTVERSION 0,4,4,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Afterhours 16 contributors"
      VALUE "FileDescription", "Afterhours 16"
      VALUE "FileVersion", "0.4.4"
      VALUE "InternalName", "Afterhours16"
      VALUE "LegalCopyright", "MIT License"
      VALUE "OriginalFilename", "Afterhours16.exe"
      VALUE "ProductName", "Afterhours 16"
      VALUE "ProductVersion", "0.4.4"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
